# Airflow user (for docker-compose)
AIRFLOW_UID=50000

# Airflow Web UI credentials (defaults: airflow / airflow)
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# ============================================================
# Everything below is OPTIONAL. Leave it blank/commented for a
# fully local run. The pipeline defaults to local storage and the
# committed models in data/models/ (no cloud accounts required).
# ============================================================

# --- Optional: also mirror raw data + predictions to AWS S3 ---
# Set ALL of these to enable S3; leave blank to stay local-only.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET=

# --- Optional: MotherDuck cloud warehouse (not used by the local run) ---
# MOTHERDUCK_TOKEN=

# --- Optional: Brevo email alerts on DAG failure ---
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=
# BREVO_SENDER_NAME=Airflow Weather Pipeline
# BREVO_ALERT_EMAIL=
